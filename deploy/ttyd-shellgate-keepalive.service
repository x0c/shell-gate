# 上游终端主机（ttyd）用户级保活单元——root 那份 ttyd-shellgate.service 的兜底。
#
# 为什么需要它：root 单元是 Restart=on-failure，进程被干净地 SIGTERM 掉（退出码 0）
# 时 systemd 不会拉起，曾因此静默停机数小时。运维账号无上游 root 权限、改不动那份
# 单元时，用用户级 systemd（已开 lingering，开机自启、注销不停）另起一套监管。
#
# 与 root 单元共存：包装脚本启动前会让出已被占用的端口（见 ttyd-keepalive.sh），
# root 的在跑就待命，不抢、不互相打架。
#
# 安装（运维账号自己就能做，不需要 root）：
#   install -m 755 deploy/ttyd-keepalive.sh ~/.local/bin/ttyd-keepalive.sh
#   install -Dm 644 deploy/ttyd-shellgate-keepalive.service \
#       ~/.config/systemd/user/ttyd-shellgate-keepalive.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ttyd-shellgate-keepalive.service
#
# 根治办法（需要 root，建议一并做）：把 /etc/systemd/system/ttyd-shellgate.service
# 里的 Restart=on-failure 改成 Restart=always，那样这份兜底就只是双保险。

[Unit]
Description=shellgate web terminal keepalive (ttyd 兜底保活)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/ttyd-keepalive.sh
# 关键：always，不是 on-failure——「被干净地停掉」正是本单元要兜住的场景。
Restart=always
RestartSec=3
# 不设启动次数上限：保活服务宁可一直重试，也不要试几次就永久放弃。
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
