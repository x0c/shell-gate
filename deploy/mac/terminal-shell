#!/bin/bash
# ttyd 每个连接都会启动本脚本。Mac 是否防睡眠由门禁按 Tab 单独管理的租约决定，
# 不能绑定到这条 WebSocket：浏览器后台、断线或刷新会重建连接，却不能丢掉原 Tab 的租约。
# 无参数则开账号默认登录壳（对齐门禁 interactiveLoginCommand）；有参时外层仍用
# bash -lc（与 Linux 侧上游登录脚本一致），具体命令由门禁包装。
#
# LaunchAgent / ttyd 常不带齐登录环境：必须在此补上账号默认壳与真彩声明，否则
# 门禁的 `exec "$SHELL" -lic` 会因 SHELL 空/错而掉进 bash，TUI 也会因缺
# COLORTERM=truecolor 被 Rich/Textual 压成 256 色（发脏）。
set -euo pipefail
cd "${HOME}"

resolve_login_shell() {
  local shell="${SHELL:-}"
  if [[ -z "$shell" || "$shell" == "/bin/sh" ]]; then
    if [[ -x /usr/bin/dscl ]]; then
      shell="$(/usr/bin/dscl . -read "/Users/$(/usr/bin/id -un)" UserShell 2>/dev/null | /usr/bin/awk '{print $2}')"
    fi
  fi
  if [[ -z "$shell" || ! -x "$shell" ]]; then
    shell="/bin/zsh"
  fi
  printf '%s\n' "$shell"
}

export SHELL="$(resolve_login_shell)"
# 与 Linux 上游的 truecolor 声明同口径（示例：/etc/profile.d/truecolor.sh）：网页 ttyd 只报 xterm-256color，
# 不声明真彩时全屏 TUI 会把主题量化成 256 色。
export COLORTERM="${COLORTERM:-truecolor}"

if [ "$#" -eq 0 ]; then
  exec "${SHELL}" -li
fi

# 兼容仍写死 `exec bash -lic` 的旧门禁：预置整段改走账号默认壳。
# 新门禁已发 `exec "$SHELL" -lic`，这条替换不会命中。
cmd="$*"
if [[ "$cmd" == 'exec bash -lic '* ]]; then
  cmd='exec "$SHELL" -lic '${cmd#exec bash -lic }
fi
exec /bin/bash -lc "$cmd"
