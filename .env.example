# Copy to .env; choose your own account. No private service is required.
SHELL_ALLOWED_EMAILS=operator@example.com
SHELL_PUBLIC_URL=http://localhost:18765
# For public HTTPS, set your domain and add compose.https.yaml.
# SHELL_DOMAIN=shell.example.com
# Optional launcher defaults, applied once per account:
SHELL_DEFAULT_PRESETS=[]
# Direct binary deployment only (Compose sets its own upstream/storage):
# SHELL_TTYD_URL=http://127.0.0.1:7681
# SHELL_DATA_DIR=./data
# Optional external authentication (never required):
# SHELL_AUTH_MODE=supabase
# SHELL_SUPABASE_URL=https://auth.example.com
# SHELL_SUPABASE_ANON_KEY=
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUERS=https://auth.example.com
# AUTH_JWT_AUDIENCE=authenticated
# Generic OIDC SSO (confidential web client; optional):
# Register <SHELL_PUBLIC_URL>/api/sso/callback at your provider.
# Compose passes these settings from .env; direct binaries need exported variables.
# SHELL_AUTH_MODE=sso
# SHELL_SSO_ISSUER=https://sso.example.com/realms/shellgate
# SHELL_SSO_CLIENT_ID=shell-gate
# SHELL_SSO_CLIENT_SECRET=
# SHELL_SSO_SCOPES=openid email profile
# SHELL_SSO_EMAIL_CLAIM=email
# Requires boolean email_verified=true by default. See deployment security guidance.
# SHELL_SSO_ALLOW_UNVERIFIED_EMAIL=false
# PostgreSQL is optional for multiple gateway instances:
# SHELL_DATABASE_URL=postgres://shellgate:password@database.example.com/shellgate?sslmode=verify-full
